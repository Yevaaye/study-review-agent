{
  "name": "study-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "导入 Markdown 教材 → 规则抽题 / AI 生成复习卡 → 审核 → FSRS 间隔复习的本地学习工具",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "serve": "npm run build && npm start",
    "lan": "node scripts/lan-proxy.mjs",
    "qr": "node scripts/make-qr.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "lint": "eslint",
    "parse:check": "node scripts/parse-check.mjs",
    "check:questions": "node scripts/question-check.mjs",
    "check:pipeline": "node scripts/question-pipeline-check.mjs",
    "check:coverage": "node scripts/question-coverage-check.mjs",
    "check:anchor": "node scripts/anchor-check.mjs",
    "check:schedule": "node scripts/schedule-check.mjs",
    "smoke": "node smoke.mjs",
    "smoke:full": "node smoke.mjs --isolated",
    "preflight": "node scripts/preflight.mjs",
    "reset:data": "node -e \"require('fs').rmSync('data/db.json',{force:true});console.log('已删除 data/db.json。注意：运行中的服务仍持有内存副本，需重启进程后才会从种子重建。')\"",
    "serve:share": "node scripts/serve-share.mjs",
    "tunnel:install": "node scripts/install-cloudflared.mjs",
    "where": "node scripts/where.mjs",
    "check:fidelity": "node scripts/fidelity-check.mjs",
    "backfill:fidelity": "node scripts/backfill-fidelity.mjs",
    "check:mdfix": "node scripts/md-mobile-check.mjs",
    "check:textbreak": "node scripts/text-break-check.mjs",
    "check:note": "node scripts/answer-note-check.mjs",
    "check:route": "node scripts/route-check.mjs",
    "check:fragstats": "node scripts/fragment-stats-check.mjs",
    "check:chat": "node scripts/chat-check.mjs",
    "check:importsession": "node scripts/import-session-check.mjs",
    "check:importjob": "node scripts/import-job-check.mjs",
    "check:progress": "node scripts/ui-progress-check.mjs",
    "check:librarystate": "node scripts/library-state-check.mjs",
    "check:answer": "node scripts/question-answer-check.mjs",
    "check:answerformat": "node scripts/answer-format-check.mjs",
    "check:answerfill": "node scripts/answer-fill-check.mjs",
    "check:answerexpansion": "node scripts/answer-expansion-check.mjs",
    "check:answerfixlog": "node scripts/answer-fix-log-check.mjs",
    "check:answerfixhttp": "node scripts/answer-fix-http-check.mjs",
    "check:answerkeys": "node scripts/answer-keys-check.mjs",
    "check:errorreport": "node scripts/error-report-check.mjs",
    "check:fragmentaudit": "node scripts/fragment-audit-check.mjs",
    "check:carderrorhttp": "node scripts/card-error-http-check.mjs",
    "backfill:multi": "node scripts/backfill-multi.mjs",
    "check:reviewprogress": "node scripts/review-progress-check.mjs",
    "check:reviewresume": "node scripts/review-resume-http-check.mjs",
    "check:reviewpersist": "node scripts/review-persist-check.mjs",
    "check:reviewfresh": "node scripts/review-answer-freshness-check.mjs",
    "check:reviewfreshhttp": "node scripts/review-answer-freshness-http-check.mjs",
    "check:reviewpersisthttp": "node scripts/review-persist-http-check.mjs",
    "check:reviewretry": "node scripts/review-retry-http-check.mjs",
    "check:wording": "node scripts/wording-check.mjs",
    "check:auditledger": "node scripts/audit-ledger-check.mjs",
    "check:auditledgerhttp": "node scripts/audit-ledger-http-check.mjs",
    "audit:export": "node scripts/audit-export.mjs",
    "check:sourceanswer": "node scripts/source-answer-check.mjs",
    "check:sourceanswerhttp": "node scripts/source-answer-http-check.mjs",
    "check:answeradjhttp": "node scripts/answer-adjacent-http-check.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
