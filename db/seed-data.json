      "heading_path": "状态码与缓存 > 缓存机制",
      "paragraph_index": 0,
      "page_start": null,
      "page_end": null,
      "char_start": 140,
      "char_end": 300,
      "locator": "状态码与缓存 · 缓存机制 第1段",
      "content": "HTTP 缓存通过 Cache-Control 控制强缓存，通过 ETag 和 Last-Modified 实现协商缓存，避免重复传输未变化的资源。",
      "content_hash": null
    }
