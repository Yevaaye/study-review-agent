# ============================================================================
#  环境变量模板  —  复制为 .env.local 后填入真实值
#    cp .env.example .env.local
#  .env.local 已被 .gitignore 忽略，不会提交到仓库
# ============================================================================

# ---------------------------------------------------------------------------
# 数据目录（可选）
# 不填 = ./data（即 data/db.json）。
# 想让同一份代码跑两个互不干扰的书库（比如自己一份、朋友一份），
# 就各自指定不同目录：npm run serve:share 会自动这么干。
# ---------------------------------------------------------------------------
# DATA_DIR=F:/projects/study-review-agent/data

# ---------------------------------------------------------------------------
# 分享口令（可选，但挂公网必须设）
# 设置后所有页面与接口都要求先输口令；留空 = 完全不设防。
# 改完需要重启进程。建议 12 位以上，别用生日/书名。
# ---------------------------------------------------------------------------
# APP_PASSWORD=

# ---------------------------------------------------------------------------
# LLM（AI 生成卡片用；缺省时「生成卡片」按钮会报配置错误，其余功能不受影响）
# 分享给朋友时，建议对方在自己的实例里填自己的 key，别共用你的额度。
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
# 或切到 DeepSeek：
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 容器构建开关（仅 Docker 部署时用）
# 设为 standalone 时 next build 产出 .next/standalone，供精简镜像使用。
# 本机跑 npm start 不要设这个值。
# ---------------------------------------------------------------------------
# NEXT_OUTPUT=standalone
